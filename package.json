{
  "name": "typewriter-text-effect",
  "version": "2.1.0",
  "description": "Simple typewriter text animation in JS/TS",
  "author": "Rajat Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RajatSinghrs/typewriter-text.git"
  },
  "homepage": "https://github.com/RajatSinghrs/typewriter-text#readme",
  "keywords": [
    "typewriter",
    "text",
    "animation",
    "typescript",
    "npm",
    "vanilla-js",
    "esm",
    "cjs"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./cursor.css": "./dist/cursor.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --out-dir dist --minify",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
